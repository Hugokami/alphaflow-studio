# AlphaFlow AI Studio — Environment Variables Template

# Groq API Keys (comma-separated for pool failover)
GROQ_API_KEYS=gsk_your_groq_api_key_here

# Google AI Studio API Keys (Gemini) (comma-separated for multi-account quota pooling)
GEMINI_API_KEYS=AQ.your_gemini_key_1,AQ.your_gemini_key_2

# Gemini TTS Smart Duration Routing Configuration
DEFAULT_GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
SHORT_VIDEO_TTS_MODEL=gemini-3.8-flash-tts
LONG_VIDEO_TTS_MODEL=gemini-3.8-flash-lite-tts
DURATION_THRESHOLD_SEC=180

# Telegram Bot Cloud Storage (Unlimited 20MB-2GB Video CDN)
TELEGRAM_BOT_TOKEN=1234567890:your_bot_token_here
TELEGRAM_CHAT_ID=
